# BrandGuard AI — Environment Variables
# Copy this file to .env (or backend/.env) and fill in your real Gemini API key.

GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides (defaults shown)
GEMINI_MODEL=gemini-3.5-flash-lite
DEMO_USERNAME=test123
DEMO_PASSWORD=test123
AUTH_SECRET=change-this-to-a-long-random-secret-in-production
